PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated allowed browser origins. Keep the GitHub Pages origin here.
CORS_ORIGINS=http://localhost:3000,https://ramandhika19.github.io
JWT_SECRET=replace-with-a-long-random-secret

# Enzonic hosted MySQL (recommended: set these in the backend host's Environment panel)
DB_HOST=your-enzonic-hostname
DB_PORT=3306
DB_USER=your-enzonic-username
DB_PASSWORD=replace-with-your-new-database-password
DB_NAME=main
DB_SSL=true

# Alternatively, set DATABASE_URL to the private connection URL supplied by Enzonic.
# Do not commit a real DATABASE_URL or password to GitHub.
# DATABASE_URL=mysql://username:password@hostname:3306/main?ssl-mode=REQUIRED

# Optional: create the first admin only when no admin exists
ADMIN_NAME=Jimbaran Hub Admin
ADMIN_EMAIL=admin@jimbaranhub.test
ADMIN_PASSWORD=replace-with-a-strong-admin-password
